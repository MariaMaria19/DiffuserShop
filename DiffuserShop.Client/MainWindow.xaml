<Window x:Class="DiffuserShop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин диффузоров" Height="538" Width="809"
        WindowStartupLocation="CenterScreen" Background="#FF9C9696">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!--Панель управления -->
        <Border Grid.Row="0" Background="#FFD6FFFF" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="Название:" Width="70"/>
                    <TextBox x:Name="txtName" Width="150" Margin="5,0"/>

                    <Label Content="Аромат:" Width="60" Margin="10,0,0,0"/>
                    <TextBox x:Name="txtScent" Width="150" Margin="5,0"/>

                    <Label Content="Цена:" Width="40" Margin="10,0,0,0"/>
                    <TextBox x:Name="txtPrice" Width="80" Margin="5,0"/>

                    <Label Content="В наличии:" Width="70" Margin="10,0,0,0"/>
                    <TextBox x:Name="txtInStock" Width="80" Margin="5,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="5" Background="#FFCCD7D9" Click="BtnAdd_Click"/>
                    <Button x:Name="btnUpdate" Content="Обновить" Width="100" Margin="5" Background="#FFCECECE"  Click="BtnUpdate_Click"/>
                    <Button x:Name="btnDelete" Content="Удалить" Width="100" Margin="5" Background="#FFCECECE" Click="BtnDelete_Click"/>
                    <Button x:Name="btnRefresh" Content="Обновить список" Width="120" Margin="5" Background="#FFCECECE" Click="BtnRefresh_Click"/>

                    <TextBox x:Name="txtSearch" Width="150" Margin="20,0,5,0"/>
                    <Button x:Name="btnSearch" Content="Найти" Width="80" Click="BtnSearch_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--Таблица -->
        <DataGrid Grid.Row="2" x:Name="dgDiffusers" 
          AutoGenerateColumns="False" Margin="0,10,0,10" Background="#FFEDEDED"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Аромат" Binding="{Binding Scent}" Width="200"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding InStock}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!--Статус -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>