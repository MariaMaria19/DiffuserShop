<Window x:Class="DiffuserShop.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="250" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#FFDFDFDF">

    <StackPanel Margin="20,0,20,0" VerticalAlignment="Center" Height="201">
        <TextBlock Text="Вход в магазин диффузоров" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#FF22CAD5"/>

        <TextBlock Text="Логин:" Margin="0,5"/>
        <TextBox x:Name="txtLogin" Margin="0,0,0,10"/>

        <TextBlock Text="Пароль:" Margin="0,5"/>
        <PasswordBox x:Name="txtPassword" Margin="0,0,0,20"/>

        <Button x:Name="btnLogin" Content="Войти" Width="80" Height="30" 
                HorizontalAlignment="Center" Click="BtnLogin_Click" BorderBrush="#FF3ACBD5"/>

        <TextBlock x:Name="lblError" Foreground="Red" 
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
</Window>